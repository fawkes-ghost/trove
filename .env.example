# Supabase project for the waitlist. The anon key is public by design; the edge function
# waitlist-signup is called from the browser with it. Set both in Vercel for every
# environment before building, because NEXT_PUBLIC_ values are inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://uvnhwgbqmwzzdvxxdgzm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend, server only. Not used yet; see lib/email/resend.ts.
RESEND_API_KEY=

# Cloudflare Turnstile site key for the waitlist form, managed mode, set in the Cloudflare
# dashboard. Public. Without it the widget is skipped. Cloudflare test keys for local work:
# 1x00000000000000000000AA always passes, 2x00000000000000000000AB always blocks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The gate. While set, every route shows the holding page until the visitor enters this
# passphrase at /enter, which sets a cookie for thirty days. Leave unset on previews: the
# gate is then off and nothing changes. Server only, never NEXT_PUBLIC.
GATE_PASSPHRASE=
